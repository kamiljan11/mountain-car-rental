# Logowanie do panelu (server-only — bez prefiksu NEXT_PUBLIC_)
APP_USER=twoj@email.pl
APP_PASSWORD=zmien-mnie
# Losowy sekret do podpisu ciasteczka sesji:
# node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
APP_AUTH_SECRET=

# Logowanie przez Google (opcjonalne — bez tego przycisk Google się nie pokaże)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase — utwórz projekt na supabase.com, klucze w Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dane bankowe na fakturze (jawne wobec klienta, ale NIE trzymane w repo).
# Ustaw w Vercel → Settings → Environment Variables. Bez nich faktura pokaze placeholder.
NEXT_PUBLIC_BANK_ISK_MOUNTAIN=
NEXT_PUBLIC_BANK_PL_OWNER=
NEXT_PUBLIC_BANK_PL_IBAN=
NEXT_PUBLIC_BANK_PL_BANK=
NEXT_PUBLIC_BANK_PL_ADDRESS=
